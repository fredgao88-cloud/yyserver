# 基础服务环境配置
ENV=production
PORT=8000

# 生产 HIS 数据库只读配置 (SQL Server 2012)
HIS_HOST=192.168.20.2
HIS_PORT=1433
HIS_USER=agent_reader
HIS_PASS=YOUR_HIS_PASSWORD_HERE
HIS_DB=his

# 本地 Agent 管理库配置 (SQL Server 2022 his_agent_db)
LOCAL_DB_HOST=sqlserver
LOCAL_DB_PORT=1433
LOCAL_DB_USER=sa
LOCAL_DB_PASS=YOUR_LOCAL_DB_PASSWORD_HERE
LOCAL_DB_NAME=his_agent_db

# DIP 规则表路径
DIP_EXCEL_PATH=/opt/hospital-agent/data/dip_rules.xlsx
